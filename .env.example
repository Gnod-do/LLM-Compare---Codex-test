# Адрес ai-proxy CodeX
LLM_API_URL=http://llm.codex.so
# Токен из чата CodeX. Никогда не коммитьте настоящий ключ.
LLM_API_KEY=your_key_here
# 1 = фейковые ответы без расхода лимита, 0 = настоящие модели
MOCK_LLM=1
PORT=3001
# Сколько мс ждать событие от модели, прежде чем считать её зависшей
IDLE_TIMEOUT_MS=60000
